# Copy this file to .env for local development.
# Never commit .env.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GITHUB_TOKEN=

# Required to approve/deny Track B API approval requests.
# Generate a long random value; never commit the real token.
ATTICUS_APPROVAL_TOKEN=

# Optional: when set, /v1 requires header X-Atticus-Api-Token.
ATTICUS_API_TOKEN=

# Optional telemetry
# ATTICUS_TELEMETRY=1
# ATTICUS_TELEMETRY_STDERR=0

# Gmail uses OAuth client secrets JSON + local token (see tools.email in config).
# Do not put OAuth client secrets in this file.

# Optional config override
ATTICUS_CONFIG_PATH=config/atticus.yaml
